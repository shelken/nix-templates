#!/usr/bin/env bash
# 输出真机标识: 环境变量 DEVICE 优先, 否则取唯一可用的真机
set -euo pipefail

if [[ -n "${DEVICE:-}" ]]; then
  echo "$DEVICE"
  exit 0
fi

devices=$(xcrun devicectl list devices \
  --filter "hardwareProperties.reality == 'physical' AND connectionProperties.tunnelState != 'unavailable'" \
  --hide-headers --hide-default-columns --columns identifier | awk '{print $1}')

case $(printf '%s' "$devices" | grep -c .) in
1) echo "$devices" ;;
0)
  echo "没有可用真机: 接线并解锁手机后重试, just devices 查看状态" >&2
  exit 1
  ;;
*)
  printf '有多台可用真机, 用环境变量 DEVICE 指定其一 (名称或 UDID):\n%s\n' "$devices" >&2
  exit 1
  ;;
esac
