set shell := ["bash", "-euo", "pipefail", "-c"]

app := "App"
bundle := "space.ooooo.app"
scheme := lowercase(app)

export APP_NAME := app
export BUNDLE_ID := bundle
export URL_SCHEME := scheme

dd := "build/dd"
product := dd + "/Build/Products/Debug-iphoneos/" + app + ".app"

# 列出可用命令
default:
    @just --list

# >>> init
# 一次性: 写入项目名与 bundle id (space.ooooo.<name 小写>), 并从本文件删除自身
init name:
    #!/usr/bin/env bash
    set -euo pipefail
    [[ "{{ name }}" =~ ^[A-Z][A-Za-z0-9]*$ ]] || { echo "name 必须是大驼峰字母数字, 如 UsageGlass" >&2; exit 1; }
    lower=$(echo "{{ name }}" | tr '[:upper:]' '[:lower:]')
    sed -e 's|^app := .*|app := "{{ name }}"|' \
        -e "s|^bundle := .*|bundle := \"space.ooooo.${lower}\"|" \
        -e '/^# >>> init$/,/^# <<< init$/d' justfile | cat -s > justfile.tmp
    mv justfile.tmp justfile
    echo "已初始化 {{ name }} (space.ooooo.${lower})"
# <<< init

# 生成 .xcodeproj (不入库); Team ID 自动探测, 多账号时 DEVELOPMENT_TEAM=<id> just gen
gen:
    #!/usr/bin/env bash
    set -euo pipefail
    DEVELOPMENT_TEAM=$(bash scripts/team) xcodegen generate

# 逻辑层测试 (Core, 在 Mac 上跑, 不需要真机)
test:
    cd Packages/Core && swift test

# 真机 Debug 构建
build: gen
    rm -rf build/last.xcresult
    xcodebuild -project {{ app }}.xcodeproj -scheme {{ app }} -configuration Debug \
      -destination 'generic/platform=iOS' -allowProvisioningUpdates \
      -derivedDataPath {{ dd }} -resultBundlePath build/last.xcresult build \
      | xcbeautify --quiet

# 取上次构建的结构化错误
errors:
    xcrun xcresulttool get build-results --path build/last.xcresult

# 列出已连接的设备
devices:
    xcrun devicectl list devices

# 构建并安装到真机; 唯一可用真机自动选中, 多台时 DEVICE=<名称或 UDID> just install
install: build
    #!/usr/bin/env bash
    set -euo pipefail
    xcrun devicectl device install app --device "$(bash scripts/device)" {{ product }}

# 以指定 Scenario 启动已安装的 App, 启动后立即返回; 其余参数透传为启动参数, 如 just launch empty -AppleLanguages '(ja)' -AppleLocale ja_JP
[positional-arguments]
launch scenario="default" *args:
    #!/usr/bin/env bash
    set -euo pipefail
    xcrun devicectl device process launch --device "$(bash scripts/device)" --terminate-existing {{ bundle }} -- -scenario "$1" "${@:2}"

# 构建、安装并以指定 Scenario 启动; 参数同 launch
[positional-arguments]
run scenario="default" *args: install
    #!/usr/bin/env bash
    set -euo pipefail
    just launch "$@"

# 构建、安装并启动, 保持前台回传 App 的 stderr/stdout 日志, Ctrl-C 结束; 参数同 launch
[positional-arguments]
console scenario="default" *args: install
    #!/usr/bin/env bash
    set -euo pipefail
    xcrun devicectl device process launch --device "$(bash scripts/device)" --terminate-existing --console {{ bundle }} -- -scenario "$1" "${@:2}"

# 产出未签名 ipa (build/<App>.ipa), 交给 Plume / go-ios 等工具签名安装; 不探测 Team ID, 不依赖 Xcode 账号, CI 可用
ipa:
    #!/usr/bin/env bash
    set -euo pipefail
    DEVELOPMENT_TEAM= xcodegen generate
    rm -rf build/{{ app }}.xcarchive build/Payload build/{{ app }}.ipa
    xcodebuild -project {{ app }}.xcodeproj -scheme {{ app }} -configuration Release \
      -destination 'generic/platform=iOS' -derivedDataPath {{ dd }} \
      -archivePath build/{{ app }}.xcarchive archive CODE_SIGNING_ALLOWED=NO | xcbeautify --quiet
    mkdir -p build/Payload
    cp -R build/{{ app }}.xcarchive/Products/Applications/{{ app }}.app build/Payload/
    (cd build && zip -qry {{ app }}.ipa Payload) && rm -rf build/Payload

# 在真机上触发 deep link, 如 just open settings
open route:
    #!/usr/bin/env bash
    set -euo pipefail
    xcrun devicectl device process launch --device "$(bash scripts/device)" --payload-url "{{ scheme }}://{{ route }}" {{ bundle }}

# 格式化 Swift 代码
fmt:
    xcrun swift-format format --in-place --recursive App Packages/Core/Sources Packages/Core/Tests
