#!/usr/bin/env bash
# 输出 DEVELOPMENT_TEAM: 环境变量优先, 否则取 Xcode 已登录账号的唯一 Team ID
set -euo pipefail

if [[ -n "${DEVELOPMENT_TEAM:-}" ]]; then
  echo "$DEVELOPMENT_TEAM"
  exit 0
fi

teams=$(defaults read com.apple.dt.Xcode IDEProvisioningTeamByIdentifier 2>/dev/null |
  grep -o 'teamID = [A-Z0-9]*' | awk '{print $3}' | sort -u || true)

case $(printf '%s' "$teams" | grep -c .) in
1) echo "$teams" ;;
0)
  echo "找不到 Team ID: 在 Xcode → Settings → Accounts 登录 Apple ID, 或设置环境变量 DEVELOPMENT_TEAM" >&2
  exit 1
  ;;
*)
  printf '检测到多个 Team ID, 用环境变量 DEVELOPMENT_TEAM 指定其一:\n%s\n' "$teams" >&2
  exit 1
  ;;
esac
